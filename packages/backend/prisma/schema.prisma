generator client {
  provider              = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id               String    @id @default(cuid())
  title            String    @default("新对话")
  model            String
  status           String    @default("idle")
  streamingContent String?
  isPinned         Boolean   @default(false)
  cwd              String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  messages         Message[]
  events           SessionEvent[]
  approvalLogs     ApprovalLog[]

  @@map("sessions")
}

model Message {
  id         String    @id @default(cuid())
  sessionId  String
  role       String
  type      String    @default("user")
  content    String
  toolCalls  String?
  mode       String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  usageInput  Int?
  usageOutput Int?

  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([sessionId])
  @@map("messages")
}

model SessionEvent {
  id        Int      @id @default(autoincrement())
  sessionId String
  seq       Int
  type      String
  dataJson  String
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@map("session_events")
}

model ApprovalLog {
  id          String   @id @default(uuid())
  sessionId   String
  action      String
  description String
  detail      String
  outcome     String
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("approval_logs")
}